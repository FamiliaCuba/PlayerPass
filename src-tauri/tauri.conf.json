{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlayerPass",
  "version": "0.1.0",
  "identifier": "com.playerpass.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PlayerPass",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "focus": true,
        "visible": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://github.com https://*.github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "fmcuba",
    "copyright": "Copyright © 2026 fmcuba",
    "category": "Utility",
    "shortDescription": "Vault local cifrado para cuentas de juegos",
    "longDescription": "PlayerPass guarda tus cuentas de juegos cifradas en tu PC (Argon2id + AES-GCM). Sin suscripción. Licencia MIT. by fmcuba.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,

    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwRUM4RTQ1NjlGNEYxMTEKUldRUjhmUnBSWTdzTUMzVXZBaEVWUXE3Q0JEc3VldEMzZ3l4WmxhSTZMam1vV0UzNHdoa2dWYWIK",
      "endpoints": [
        "https://github.com/FamiliaCuba/PlayerPass/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
